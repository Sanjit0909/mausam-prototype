ENV=development

# Google Gemini (AI Weather Assistant). Leave blank to use the rule-based fallback assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenWeatherMap - automatic fallback if Open-Meteo is rate-limited on shared hosting IPs
OPENWEATHERMAP_API_KEY=

# Allowed frontend origin(s) for CORS
CORS_ORIGINS=http://localhost:3000
