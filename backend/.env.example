ENV=development

# Google Gemini - AI fallback tier 2 (if DeepSeek fails/unavailable). Leave blank to skip straight to rule-based.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek V4 Flash - PRIMARY AI assistant. Falls back to Gemini, then to rule-based templates.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenWeatherMap - weather/forecast fallback if Open-Meteo is rate-limited on shared hosting IPs.
OPENWEATHERMAP_API_KEY=

# Weatherstack - third weather fallback rung / validation source.
WEATHERSTACK_API_KEY=

# Stormglass - marine fallback (check your plan's daily request limit before enabling).
# Used only for tide extremes (Open-Meteo Marine has no tide data), heavily cached.
STORMGLASS_API_KEY=

# IMD - official India Meteorological Department (requires portal account + IP whitelisting).
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in/api/v1

# INCOIS - official Indian marine authority (requires requested access).
INCOIS_API_KEY=

# Allowed frontend origin(s) for CORS
CORS_ORIGINS=http://localhost:3000
