ENV=development

# Google Gemini - AI fallback tier 2 (if DeepSeek fails/unavailable).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek V4 Flash - PRIMARY AI assistant.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter - AI fallback tier 3. Model openrouter/free auto-picks an available free model.
# If this key is missing or the call fails, MAUSAM's rule engine answers instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenWeatherMap - weather/forecast fallback if Open-Meteo is rate-limited on shared hosting IPs.
OPENWEATHERMAP_API_KEY=

# Weatherstack - third weather fallback rung / validation source.
WEATHERSTACK_API_KEY=

# Stormglass - marine fallback (check your plan's daily request limit before enabling).
# Used only for tide extremes (Open-Meteo Marine has no tide data), heavily cached.
STORMGLASS_API_KEY=

# IMD - official India Meteorological Department (portal account + IP whitelisting required).
# Dual-header auth: X-API-KEY + Authorization Bearer JWT from oauth/token.php
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in/api/v1
IMD_EMAIL=
IMD_PASSWORD=
# JWT endpoint is NOT under IMD_BASE_URL (/api/v1). Leave default unless IMD changes it.
IMD_OAUTH_TOKEN_URL=https://api.imd.gov.in/api/oauth/token.php

# INCOIS - official Indian marine authority (requires requested access).
INCOIS_API_KEY=

# Allowed frontend origin(s) for CORS
CORS_ORIGINS=http://localhost:3000
